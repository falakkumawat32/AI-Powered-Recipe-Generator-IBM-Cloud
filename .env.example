# ══════════════════════════════════════════════════
# RecGenAI — Environment Configuration
# ══════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ── IBM Watsonx AI ──────────────────────────────
# Get these from: https://cloud.ibm.com/
# 1. Create a Watsonx.ai project at https://dataplatform.cloud.ibm.com/
# 2. Generate an API key at IAM: https://cloud.ibm.com/iam/apikeys
# 3. Copy your Project ID from the project settings page

IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Model Selection ─────────────────────────────
# Available IBM Granite models:
#   ibm/granite-13b-instruct-v2   (recommended — best for instructions)
#   ibm/granite-13b-chat-v2       (optimised for conversation)
#   ibm/granite-3b-code-instruct  (smaller / faster)
#   meta-llama/llama-3-70b-instruct (powerful but slower)
IBM_WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Embedding Model ─────────────────────────────
# Used for semantic similarity search
IBM_WATSONX_EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr

# ── Rate Limiting ────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
